# Copy to .env and adjust. .env is git-ignored — no personal identifiers live
# in tracked source; they all come from here or data/portfolio.json.

# Required — the agent polls this GitHub account's public non-fork repos.
GITHUB_USERNAME=your-github-username

# Optional: raises GitHub API rate limit from 60 -> 5000 req/h.
GITHUB_TOKEN=

# Required (or set MEDIUM_FEED_URL instead) — the part after @ in
# medium.com/@handle.
MEDIUM_USERNAME=your-medium-username

# Optional: set instead of MEDIUM_USERNAME if your feed URL isn't the default
# @handle shape (e.g. a custom domain blog on Medium).
# MEDIUM_FEED_URL=https://medium.com/feed/@your-medium-username

# Local Ollama model used to draft project entries (must be pulled first: `ollama pull qwen3:8b`)
OLLAMA_MODEL=qwen3:8b

# Ollama REST endpoint
OLLAMA_HOST=http://localhost:11434

# "pr" (default): agent opens a PR for review, nothing redeploys until you merge.
# "direct": agent commits and pushes straight to the current branch (old behavior).
# PR mode requires the `gh` CLI installed and authenticated (`gh auth login`).
PUSH_MODE=pr
